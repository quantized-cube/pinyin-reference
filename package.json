{
  "name": "pinyin-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "普通話のピンイン・IPA・発音リファレンス",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.tools.json && node .build/scripts/build.js",
    "prestart": "npm run build",
    "start": "node .build/scripts/server.js",
    "test": "npm run build && node .build/scripts/test.js",
    "test:data": "python -m unittest discover -s tests -p test_*.py",
    "data:check": "python scripts/build_examples.py --check",
    "data:refresh": "npm run test:data && python scripts/build_examples.py && npm test",
    "data:update": "npm run test:data && python scripts/build_examples.py --update-source && npm test",
    "audio:check": "python scripts/build_recordings.py --check"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "20.19.43",
    "jsdom": "29.1.1",
    "typescript": "7.0.2"
  }
}
